# Copy to `.env` and fill in before running anywhere other than your own machine.

# Signs the JWTs used for login sessions.
#
# IMPORTANT: the application falls back to a well-known default when this is
# unset. That default is published in this repository, so anyone could forge a
# session token against a deployment that has not set its own. Always set a long
# random value before exposing the app to the internet, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the SQLite file lives. Defaults to roast_app.db next to the backend.
SQLITE_DB_PATH=roast_app.db
